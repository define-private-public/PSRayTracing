# Note that this isn't really a "good" example of a Makefile; it's meant to be
# something that's quick and dirty to get the job done.  It works for GCC and
# clang.  You may need to modify it for a different compiler version or
# location.
#
# MSVC is a bit wonky, but kinda works.  You need to use some different
# (specific) commands/targets and have the developer tools command line running

# Only -O3 is enabled since that's likely what will be used in a real world project.
# (same with /O2 for Windows)


GCC_CXX=g++
CLANG_CXX=clang++
MSVC_CXX=cl

SRC = benchmark.cpp

# Building the tests
all: build_gcc build_clang

clean:
	rm test_*

build_gcc: $(SRC)
#	$(GCC_CXX) $(SRC) -O0    -o test_gcc_O0
#	$(GCC_CXX) $(SRC) -O1    -o test_gcc_O1
#	$(GCC_CXX) $(SRC) -O2    -o test_gcc_O2
	$(GCC_CXX) $(SRC) -O3    -o test_gcc_O3
#	$(GCC_CXX) $(SRC) -Ofast -o test_gcc_Ofast

build_clang: $(SRC)
#	$(CLANG_CXX) $(SRC) -O0    -o test_clang_O0
#	$(CLANG_CXX) $(SRC) -O1    -o test_clang_O1
#	$(CLANG_CXX) $(SRC) -O2    -o test_clang_O2
	$(CLANG_CXX) $(SRC) -O3    -o test_clang_O3
#	$(CLANG_CXX) $(SRC) -Ofast -o test_clang_Ofast

build_unix: build_gcc build_clang

build_msvc: $(SRC)
#	$(MSVC_CXX) $(SRC) /Od /Fetest_msvc_Od.exe
