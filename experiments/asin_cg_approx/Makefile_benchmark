# Note that this isn't really a "good" example of a Makefile; it's meant to be
# something that's quick and dirty to get the job done.  It works for GCC and
# clang.  You may need to modify it for a different compiler version or
# location.

GCC_CXX=g++
CLANG_CXX=clang++
MSVC_CXX=cl

SRC = benchmark.cpp

# Building the tests
all: build_gcc build_clang

clean:
	rm -f test_*

build_gcc: $(SRC)
	$(GCC_CXX) $(SRC) -O3 -o test_gcc_O3

build_clang: $(SRC)
	$(CLANG_CXX) $(SRC) -O3 -o test_clang_O3

build_unix: build_gcc build_clang

build_msvc: $(SRC)
	$(MSVC_CXX) $(SRC) /O2 /Fetest_msvc_O2.exe /std:c++20

# Running the tests
SEED = "ASDF"
NUM_RUNS = "250"
NUM_VECTORS = "10000000"

run_tests_unix:
	$(GCC_CXX) --version
	@echo ""
	$(CLANG_CXX) --version
	@echo ""

	@echo "--- GCC ---"
	./test_gcc_O3 $(SEED) $(NUM_RUNS) $(NUM_VECTORS)
	@echo "--- Clang ---"
	./test_clang_O3 $(SEED) $(NUM_RUNS) $(NUM_VECTORS)

run_tests_windows:
	@echo "--- GCC ---"
	test_gcc_O3 $(SEED) $(NUM_RUNS) $(NUM_VECTORS)
	@echo "--- MSVC ---"
	test_msvc_O2.exe $(SEED) $(NUM_RUNS) $(NUM_VECTORS)
